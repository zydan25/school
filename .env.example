DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://school:school@localhost:5432/school
TIME_ZONE=Asia/Aden
LANGUAGE_CODE=ar
REDIS_URL=redis://localhost:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# API device sessions
API_SESSION_LIFETIME_DAYS=30

# SMS/OTP delivery backend. Implement a callable accepting keyword args:
# backend(phone: str, message: str, purpose: str) -> bool | None
# Keep empty until a real provider is configured; OTP endpoints then fail closed.
PHONE_OTP_DELIVERY_BACKEND=
DEFAULT_FROM_EMAIL=no-reply@school.example
